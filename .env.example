# Server only. Never prefix secrets with VITE_. Leave blank for labeled demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Used only for explicitly confirmed recorded-audio uploads.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
PORT=3001
# Keep localhost for development. Place an authenticated HTTPS proxy in front before public deployment.
HOST=127.0.0.1
# Shared tutoring/transcription requests per IP per minute. Tests override this.
API_REQUESTS_PER_MINUTE=20
# Set to loopback ONLY behind a trusted same-machine HTTPS proxy that sanitizes forwarding headers.
TRUST_PROXY=
